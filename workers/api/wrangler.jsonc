{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pureihram-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Same-origin home for the admin API, so the Access login cookie reaches it.
  // workers_dev stays on explicitly: the public forms still post there, and
  // declaring a route would otherwise switch it off.
  "routes": [{ "pattern": "www.pureihram.com/api/*", "zone_name": "pureihram.com" }],
  "workers_dev": true,
  "services": [{ "binding": "PUSH", "service": "pureihram-push", "entrypoint": "PushAdmin" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pureihram",
      "database_id": "df66ce18-1b1c-494d-8da6-29e43b591316",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.pureihram.com,https://pureihram.com",
    // Klaviyo's public site ID, the same one index.html loads klaviyo.js with.
    // Using the public client endpoints means no private Klaviyo key lives here.
    "KLAVIYO_COMPANY_ID": "TGazgN",
    // The "Hajj Guide Subscribers" list. Empty skips the list subscription,
    // exactly as the Supabase function did when its list secret was unset.
    "KLAVIYO_PREP_PACK_LIST_ID": "",
    "SUPABASE_URL": "https://cimjybhmilaecqhnqrby.supabase.co",
    // From the Access application "Pure Ihram admin". Empty keeps /admin/*
    // answering 503, so nothing is reachable before Access is in place.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "rafi.drifly@gmail.com"
  }
  // Secrets, set with `npx wrangler secret put <NAME>`:
  //   RESEND_API_KEY             delivers contact-form messages to the shop inbox
  //   SUPABASE_SERVICE_ROLE_KEY  lets the admin routes read and write Supabase
}
